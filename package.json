{
  "name": "multiphone-hub",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/agent"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "agent:dev": "npm run dev --workspace @multiphone-hub/agent",
