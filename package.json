    "agent:typecheck": "npm run typecheck --workspace @multiphone-hub/agent"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "next": "^15.5.6",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.7",
    "eslint": "^9.30.1",
    "eslint-config-next": "^15.5.6",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.8.3",
    "@tailwindcss/postcss": "^4.1.11",
    "@eslint/eslintrc": "^3.3.1"
  }
}